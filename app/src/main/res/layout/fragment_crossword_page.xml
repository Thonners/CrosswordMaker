<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android.support.design="http://schemas.android.com/apk/res-auto"
    tools:context="com.thonners.crosswordmaker.CrosswordPageFragment">

    <LinearLayout
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:orientation="vertical"
        tools:context="com.thonners.crosswordmaker.CrosswordActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.thonners.crosswordmaker.CrosswordCanvas
                android:id="@+id/edit_crossword_canvas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android.support.design:layout_constraintStart_toStartOf="parent"
                android.support.design:layout_constraintTop_toTopOf="parent"
                android.support.design:layout_constrainedWidth="false"
                android.support.design:layout_constraintDimensionRatio="1:1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/clues_checklist_parent_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/clues_checklist_parent_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clues_checklist_across_header"
                    style="@style/clues_checklist_header"
                    android:text="@string/across" />

                <GridLayout
                    android:id="@+id/clues_checklist_across_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/clues_checklist_down_header"
                    style="@style/clues_checklist_header"
                    android:text="@string/down" />

                <GridLayout
                    android:id="@+id/clues_checklist_down_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_weight="0"
            android:orientation="vertical">

            <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:layout_weight="0"
                android:orientation="horizontal">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/add_word_split"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/fab_margin"
                    android:layout_marginTop="@dimen/fab_margin"
                    android:layout_marginBottom="@dimen/fab_margin"
                    android:padding="0dp"
                    android.support.design:fabSize="normal"
                    android:elevation="@dimen/fab_elevation"
                    android.support.design:borderWidth="0dp"
                    android:src="@drawable/cell_word_split"
                    android:tooltipText="@string/add_word_split_tooltip"
                    android:scaleType="center"
                    app:maxImageSize="35dp"

                    />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/add_hyphen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="right|center_vertical"
                    android:layout_marginLeft="@dimen/fab_margin"
                    android:layout_marginTop="@dimen/fab_margin"
                    android:layout_marginBottom="@dimen/fab_margin"
                    android.support.design:fabSize="normal"
                    android:elevation="@dimen/fab_elevation"
                    android.support.design:borderWidth="0dp"
                    android:src="@drawable/cell_hyphen"
                    android:tooltipText="@string/add_hyphen_tooltip"
                    android:scaleType="center"
                    app:maxImageSize="15dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
