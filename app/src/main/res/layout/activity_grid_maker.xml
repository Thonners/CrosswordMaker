<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android.support.design="http://schemas.android.com/apk/res-auto"
    android:id="@+id/grid_maker_relative_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.thonners.crosswordmaker.GridMaker">

    <LinearLayout
        android:id="@+id/grid_maker_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_below="@id/main_grid_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.thonners.crosswordmaker.CrosswordCanvas
                android:id="@+id/edit_crossword_canvas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android.support.design:layout_constraintStart_toStartOf="parent"
                android.support.design:layout_constraintTop_toTopOf="parent"
                android.support.design:layout_constrainedWidth="false"
                android.support.design:layout_constraintDimensionRatio="1:1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_add"
        android:layout_marginBottom="20dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android.support.design:fabSize="normal"
        android:onClick="enterClicked"
        android:elevation="@dimen/fab_elevation"
        android.support.design:borderWidth="0dp" />


</RelativeLayout>