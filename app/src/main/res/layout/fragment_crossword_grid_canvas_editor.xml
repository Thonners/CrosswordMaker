<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android.support.design="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.thonners.crosswordmaker.ui.components.CrosswordCanvas
        android:id="@+id/edit_crossword_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android.support.design:layout_constraintStart_toStartOf="parent"
        android.support.design:layout_constraintTop_toTopOf="parent"
        android.support.design:layout_constrainedWidth="false"
        android.support.design:layout_constraintDimensionRatio="1:1" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_edit_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android.support.design:layout_constraintEnd_toEndOf="parent"
        android.support.design:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_menu_save_white"
        android:layout_marginBottom="@dimen/fab_lower_margin_footer_button"
        android:layout_marginEnd="@dimen/fab_margin"
        android.support.design:fabSize="normal"
        android:onClick="saveClicked"
        android:elevation="@dimen/fab_elevation"
        android.support.design:borderWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>